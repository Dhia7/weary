# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Option A: Single connection string (preferred in production)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# DB_SSL=true

# Option B: Discrete fields
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wear_db
DB_USER=postgres
DB_PASSWORD=dhianaija123

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
# Production: use 32+ chars; tokens expire after 24h unless overridden
# JWT_EXPIRES_IN=24h

# Sign in with Google (same Client ID as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
# Setup steps: see GOOGLE_SIGNIN.md in this folder
GOOGLE_CLIENT_ID=

# Frontend URL (for CORS)
# For HTTP (default)
FRONTEND_URL=http://localhost:3000

# For HTTPS (uncomment and comment out the HTTP version above)
# FRONTEND_URL=https://localhost:3000

# For Production (Render deployment)
# Replace with your actual Vercel frontend URL
# FRONTEND_URL=https://your-frontend-app.vercel.app
# BACKEND_URL=https://your-backend-app-name.onrender.com

# Email (OVHcloud SMTP — preferred for production)
# MX Plan / email hosting: smtp.mail.ovh.net, port 465 (SSL) or 587 (STARTTLS)
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@swisia.store
SMTP_PASS=your_ovh_mailbox_password
MAIL_FROM=Swisia <admin@swisia.store>
# Where contact forms and new-order alerts are delivered
ADMIN_NOTIFY_EMAIL=admin@swisia.store

# Optional Resend fallback (only used if SMTP_* is not fully set)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Swisia <admin@swisia.store>

# File Upload Configuration - Cloudinary (Required for production on Render)
# Get these from https://cloudinary.com/console (free tier available)
# Without Cloudinary, images will be stored locally and lost on server restart/redeploy
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate limiting (enabled automatically in production)
# Set to true in development to test rate limits locally
ENABLE_RATE_LIMIT=false
# Optional: shared Redis store for multi-instance deployments (Render, etc.)
# REDIS_URL=redis://default:password@host:6379
